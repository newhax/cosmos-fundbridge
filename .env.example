# --- LLM router -------------------------------------------------------------------
# Roles: prospector/verifier/parser -> Gemini FAST, researcher -> Gemini MAIN,
#        writer/followup_draft -> Claude (falls back to Gemini MAIN).
# PRIVACY: Gemini's free tier may use prompts/responses to improve Google products and
# human reviewers may read them. Only public CSR data + demo NGO details. No confidential data.
# Get a key at https://aistudio.google.com/apikey (leave empty for offline templates)
GEMINI_API_KEY=
# Free-tier models (https://ai.google.dev/gemini-api/docs/pricing). Check exact names in AI Studio.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_MAIN=gemini-3.8-flash
# Extra Gemini models on the same key (each has its own free daily quota), tried after MAIN
GEMINI_MODEL_BACKUPS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# Optional: small trial credit, used sparingly
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# live | cached (replay cache only, zero API calls) | gemini_only (never call Claude)
LLM_MODE=live
CLAUDE_MAX_CALLS_PER_RUN=15
# gemini | claude  (researcher defaults to Gemini MAIN)
RESEARCHER_PROVIDER=gemini
# Copy your real free-tier limits from https://aistudio.google.com/rate-limit
GEMINI_RPM=10
GEMINI_DAILY_LIMIT=250
CLAUDE_RPM=20
CLAUDE_DAILY_LIMIT=100
# Seconds per LLM request before falling back to the next model
LLM_TIMEOUT_S=30
# Start the next model in parallel if one has not answered after this many seconds (0 = off)
LLM_HEDGE_AFTER_S=8
LLM_MAX_429_RETRIES=3
# Model requests one signed-in user may trigger per day (all features); beyond it: templates + "capacity reached"
LLM_USER_DAILY_CAP=60

# --- Backends ----------------------------------------------------------------
# meko | local     (local = SQLite file under data/memory/)
MEMORY_BACKEND=meko

# --- Meko (only used when MEMORY_BACKEND=meko) --------------------------------
# Create a key in Meko under Settings > API Keys (starts with mko_tkn_)
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
MEKO_API_KEY=mko_tkn_eel7p6soi7sxvqbwfz7i7p5kfty5diexjixlu6q
# Optional: scope memories/artifacts to a specific datapack
MEKO_DATAPACK_ID=a6612a68-9386-4d69-85d3-eefe873b3c0c

# --- Platform (accounts: ngo / company / donor) ----------------------------------
# DEMO_MODE prints verification/reset links to the server console instead of emailing.
DEMO_MODE=true
# Off for the prototype; set true for a real deployment (needs an email provider)
REQUIRE_EMAIL_VERIFICATION=false
# Signs session cookies. scripts/demo.py generates one if empty. Required when DEMO_MODE=false.
SESSION_SECRET=
# Set true behind HTTPS
COOKIE_SECURE=false
SESSION_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
PITCHES_PER_NGO_PER_DAY=5
APP_BASE_URL=http://localhost:5173
# Demo accounts use DEMO_PASSWORD (default demo-pass-2026 only in DEMO_MODE)
DEMO_PASSWORD=

# --- App -----------------------------------------------------------------------
API_PORT=8000
WEB_PORT=5173
# Years of filings to consider when ranking
LOOKBACK_YEARS=5
